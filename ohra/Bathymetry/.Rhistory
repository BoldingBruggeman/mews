# Load libraries
library(sf)
library(lubridate)
# Define base input and output roots
source_root <- "/home/muhammed/Projects/MEWS/J2000_Ohra_Gera_sims_climate_data/01_J2KKLIMA_INPUT_UTM"
output_root <- "/home/muhammed/Projects/MEWS/J2000_Ohra_Gera_sims_climate_data/01_J2KKLIMA_INPUT_UTM_MET"
# Define the processing function
process_dat_to_met <- function(dat_path) {
lines <- readLines(dat_path)[c(13, 14)]
pixels <- read.table(text = lines, sep = "\t", header = FALSE)
df <- read.table(dat_path, skip = 16)
lon <- 10 + 43/60 + 0/3600
lat <- 50 + 45/60 + 48/3600
pt <- sf::st_sfc(sf::st_point(c(lon, lat)), crs = 4326)
pt_utm <- sf::st_transform(pt, crs = 32632)
coords_utm <- sf::st_coordinates(pt_utm)
target_x <- coords_utm[1]
target_y <- coords_utm[2]
x <- as.numeric(pixels[1, -1])
y <- as.numeric(pixels[2, -1])
pixel_coords <- data.frame(x = x, y = y, col = 2:(ncol(pixels)))
dists <- sqrt((pixel_coords$x - target_x)^2 + (pixel_coords$y - target_y)^2)
nearest_idx <- order(dists)[1:4]
neighbors <- pixel_coords[nearest_idx, ]
neighbor_dists <- dists[nearest_idx]
neighbor_dists[neighbor_dists == 0] <- 1e-9
neighbor_cols <- neighbors$col
vals <- lapply(neighbor_cols, function(j) as.numeric(df[[j]]))
vals_matrix <- do.call(cbind, vals)
weights <- 1 / neighbor_dists
weights <- weights / sum(weights)
interp_temp <- as.vector(vals_matrix %*% weights)
result <- data.frame(
date = dmy(df$V1),
temp_interp = interp_temp
)
return(result)
}
lon
10 + 43/60 + 0/3600
50 + 45/60 + 48/3600
